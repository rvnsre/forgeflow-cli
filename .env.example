# Set one or more API keys that you own. Never commit real keys.
OPENAI_API_KEY=
# Optional comma-separated list of keys owned by you. Rate limits are always respected.
FORGEFLOW_API_KEYS=
FORGEFLOW_MODEL=gpt-6.1-sol
FORGEFLOW_TOKEN_LIMIT_PARAMETER=max_completion_tokens
# Optional OpenAI-compatible endpoint, e.g. a local server you control.
FORGEFLOW_BASE_URL=https://api.openai.com/v1

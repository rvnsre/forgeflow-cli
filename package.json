{
  "name": "forgeflow-cli",
  "version": "0.2.0",
  "description": "Cross-platform, resumable coding agent orchestrator with browser tools and token budgets",
  "type": "module",
  "bin": {
    "forgeflow": "./bin/forgeflow.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/forgeflow.mjs",
    "doctor": "node ./bin/forgeflow.mjs doctor",
    "check": "node ./src/check-syntax.mjs"
  },
  "peerDependencies": {
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rvnsre/forgeflow-cli.git"
  },
  "bugs": {
    "url": "https://github.com/rvnsre/forgeflow-cli/issues"
  },
  "homepage": "https://github.com/rvnsre/forgeflow-cli#readme",
  "keywords": [
    "ai-agents",
    "cli",
    "coding-agent",
    "multi-agent",
    "playwright",
    "automation",
    "checkpoint",
    "nodejs"
  ]
}
